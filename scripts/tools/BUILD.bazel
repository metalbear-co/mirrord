load("@npm//:markdownlint-cli2/package_json.bzl", markdownlint_cli2 = "bin")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

# The programs that the checks of `bazel run //:lint` and the formatters of `bazel run //:format`
# run by name, which Bazel downloads or builds, so that every machine runs the same versions and
# nobody installs them. `mirrord_runner` puts the directory of each file at the start of `PATH`
# (see `put_tools_on_path`), so the programs that the checks start, like `cargo deny`, which runs
# `cargo-deny`, find them too.
#
# Public, for the lint and the formatters of other modules, like the operator, whose targets pass it
# the same way, with their own programs.
filegroup(
    name = "tools",
    srcs = [
        ":markdownlint-cli2",
        ":towncrier",
        "@multitool//tools/buildifier",
        "@multitool//tools/cargo-deny",
        "@multitool//tools/cargo-shear",
        # `.github/scripts/flaky-tests.sh` reads the GitHub API's answers with it.
        "@multitool//tools/jq",
        "@multitool//tools/ruff",
        "@multitool//tools/starpls",
        "@multitool//tools/ty",
        "@multitool//tools/typos",
        "@multitool//tools/vale",
        # Its launcher also puts the Node.js of rules_nodejs on `PATH`, so the frontends' scripts
        # that pnpm runs, like ESLint, run with it.
        "@pnpm",
        # cargo-deny and cargo-shear read the workspace with `cargo metadata`, which runs rustc.
        # rustc loads the libraries next to it.
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
        "@rules_rust//rust/toolchain:current_rustc_lib_files",
    ],
    visibility = ["//visibility:public"],
)

# The version in the root `package.json`.
markdownlint_cli2.markdownlint_cli2_binary(name = "markdownlint-cli2")

# The version in `//mirrord/test-utils:requirements.in`.
py_console_script_binary(
    name = "towncrier",
    pkg = "@pip//towncrier",
)
