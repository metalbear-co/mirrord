load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@crates//mirrord-agent:data.bzl", "crate_data")
load("@rules_img//img:layer.bzl", "image_layer", "layer_from_tar")
load("//bazel:compatibility.bzl", "LINUX_ONLY")
load("//bazel:image.bzl", "IMAGE_LABELS", "image_targets")
load("//bazel:rust.bzl", "crate_package")

crate = crate_package(crate_data = crate_data())

crate.binary(
    compile_data = ["src/http/session_ended.html"],
    target_compatible_with = LINUX_ONLY,
    # Public for the modules that depend on mirrord and ship the agent themselves.
    visibility = ["//visibility:public"],
)

crate.unit_tests(
    test_threads = 4,
    size = "medium",
    target_compatible_with = LINUX_ONLY,
)

image_layer(
    name = "image_layer",
    srcs = {
        "/mirrord-agent": ":agent",
        # `iptables` creates its lock file, `/run/xtables.lock`, and fails when `/run` doesn't
        # exist.
        "/run": "//bazel:empty_directory",
    },
    include_runfiles = False,
    target_compatible_with = LINUX_ONLY,
)

# Copies only the programs that the agent runs, like `iptables` and `ss`, and the libraries that
# they and the agent load, out of the Debian packages in `@agent_runtime`. The packages are
# 59 MB (23 MB gzipped), mostly files the agent never uses, and this layer is 10.7 MB (4.0 MB
# gzipped).
run_binary(
    name = "image_runtime",
    srcs = [
        ":agent",
        "@agent_runtime//:flat",
    ],
    outs = ["image_runtime.tar.gz"],
    tool = "//bazel:elf_closure",
    args = [
        "$(execpath @agent_runtime//:flat)",
        "$(execpath image_runtime.tar.gz)",
        "--elf",
        "$(execpath :agent)",
        "/usr/sbin/iptables-nft",
        "/usr/sbin/ip6tables-nft",
        "/usr/sbin/iptables-legacy",
        "/usr/sbin/ip6tables-legacy",
        "/usr/bin/ss",
        "/usr/sbin/conntrack",
        "/usr/bin/sleep",
        "/usr/bin/cat",
    ] + select({
        # `iptables` loads its extensions from `xtables` with `dlopen`, so they aren't in its ELF
        # headers, where `elf_closure` looks for the libraries that a program loads.
        "@platforms//cpu:aarch64": ["/usr/lib/aarch64-linux-gnu/xtables"],
        "@platforms//cpu:x86_64": ["/usr/lib/x86_64-linux-gnu/xtables"],
    }),
    target_compatible_with = LINUX_ONLY,
)

layer_from_tar(
    name = "image_runtime_layer",
    src = ":image_runtime",
    target_compatible_with = LINUX_ONLY,
)

image_targets(
    name = "image",
    registry = "ghcr.io",
    repository = "metalbear-co/mirrord",
    layers = [
        ":image_runtime_layer",
        ":image_layer",
    ],
    cmd = ["./mirrord-agent"],
    labels = IMAGE_LABELS,
    # Public for the modules that depend on mirrord and load the image into their test clusters.
    visibility = ["//visibility:public"],
)
