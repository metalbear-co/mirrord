load("//bazel:rust.bzl", "rust_library")

rust_library(
    name = "env",
    visibility = ["//visibility:public"],
)

# The library with its `schema` feature too, which only crates outside the workspace turn on, like
# the operator's, so that the code behind it compiles and clippy lints it (see
# `//mirrord/kube:kube_incluster`). The target names the feature's optional dependency, because
# `@crates` only gives a package the optional dependencies that the workspace's features turn on.
rust_library(
    name = "env_schema",
    crate_features = ["schema"],
    doc = False,
    deps = ["@crates//schemars"],
)
