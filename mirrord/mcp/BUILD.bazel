load("@tar.bzl//tar:tar.bzl", "tar")
load("//bazel:rust.bzl", "rust_library", "rust_test")

CORPUS = glob([
    "corpus/docs/**",
    "corpus/skills/**",
])

# The vendored docs and skills, packed into the gzipped tar that `src/corpus.rs` embeds. The entries
# are relative to `corpus/`, which is how the crate names them.
#
# The mtree lists each file with fixed metadata, so the same corpus always packs to the same bytes.
# `glob` returns the files sorted, so the entries are sorted too. The lines are written out here
# rather than generated by tar.bzl's default mtree, because that mtree would also add an entry for
# each directory, and the crate expects an entry for each file only.
#
# Spaces separate the fields of an mtree line, so a space in a file's name is written as `\040`,
# as tar.bzl's default mtree writes it. The corpus's names are upstream's, which `sync --bump`
# copies as they are. Each line takes its file from the file's path in the workspace, which is
# where a source file is when the action runs, because `$(execpath)` would expand to the name with
# its spaces as they are.
tar(
    name = "corpus",
    srcs = CORPUS,
    out = "corpus.tar.gz",
    compress = "gzip",
    mtree = [
        "{} uid=0 gid=0 time=0 mode=0644 type=file content={}/{}".format(
            path.removeprefix("corpus/"),
            package_name(),
            path,
        )
        for path in [path.replace(" ", "\\040") for path in CORPUS]
    ],
)

rust_library(
    name = "mcp",
    compile_data = [
        ":corpus",
        "corpus/docs.pin.json",
        "corpus/skills.pin.json",
    ],
    rustc_env = {"MIRRORD_BUNDLED_MCP_CORPUS": "$(execpath :corpus)"},
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_tests",
    crate = ":mcp",
)

rust_test(
    name = "server",
    deps = [":mcp"],
)
