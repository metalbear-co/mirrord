load("@crates//mirrord-tui:data.bzl", "crate_data")
load("//bazel:compatibility.bzl", "UNIX_ONLY")
load("//bazel:rust.bzl", "crate_package")

crate = crate_package(crate_data = crate_data())

crate.library(
    compile_data = [
        "resources/logo-big",
        "resources/logo-small",
    ],
)

crate.unit_tests(
    compile_data = ["src/screens/targets/testdata/mirrord-up-example.yaml"],
)

crate.binary()

crate.integration_tests(
    target_compatible_with = UNIX_ONLY,
)
