# Each test runs `//mirrord/cli`, which loads the layer from its runfiles.
crate.integration_tests(
    data = ["//mirrord/cli"],
    tests = {
        name: {
            "data": ["//mirrord/layer-tests/apps/" + app for app in test.get("apps", [])] + [
                "configs/" + config
                for config in test.get("configs", [])
            ] + test.get("data", []),
            "target_compatible_with": test.get("target_compatible_with", []),
            "test_threads": test.get("test_threads", 1),
        }
        for name, test in TESTS.items()
    },
    # Some tests take half a minute, because each one starts the CLI and an app, and a small test's
    # timeout is one minute, which a busy machine can exceed.
    size = "medium",
)
