From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vinicius Deolindo <viniciusd@metalbear.com>
Date: Fri, 13 Nov 2026 01:00:39 -0300
Subject: [PATCH] librdkafka: don't use getentropy() on Linux

The module's `config.h` assumes that Linux has `getentropy()`, which
glibc only has since 2.25. mirrord links against glibc 2.17, so a
librdkafka that called `getentropy()` would need a newer glibc than the
rest of the build. With `HAVE_GETENTROPY` at 0, librdkafka seeds its
random numbers from OpenSSL instead.
---
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -144,6 +144,8 @@
         "//conditions:default": {},
     }) | select({
         "@platforms//os:linux": {
+            # glibc only has `getentropy()` since 2.25, and the builds link against glibc 2.17.
+            "#cmakedefine01 HAVE_GETENTROPY": "#define HAVE_GETENTROPY 0",
             "#cmakedefine01 HAVE_PTHREAD_SETNAME_GNU": "#define HAVE_PTHREAD_SETNAME_GNU 1",
         },
         "@platforms//os:macos": {
