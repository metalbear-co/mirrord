{
  "target": {
    "path": "serverless/demo-service",
    "namespace": "demo-env"
  },
  "key": "demo-serverless",
  "feature": {
    "env": false,
    "fs": "read",
    "network": {
      "outgoing": true,
      "incoming": {
        "mode": "steal",
        "http_filter": {
          "all_of": [
            { "header": "^baggage: .*mirrord-session={{ key }}.*$" },
            { "header": "^user-agent: .*?(?!ELB-HealthChecker).*?$"}
          ]
        }
      },
      "dns": {
        "enabled": true,
        "filter": {
          "local": []
        }
      }
    }
  }
}
