{
  "target": {
    "path": "serverless/demo-service/container/392e4a6224bf",
    "namespace": "demo-env"
  },
  "agent": {
    "clean_iptables_on_start": false
  },
  "experimental": {
    "disable_reuseaddr": false
  },
  "feature": {
    "env": true,
    "fs": "read",
    "network": {
      "outgoing": true,
      "incoming": {
        "mode": "steal",
        "http_filter": {
          "header_filter": "^baggage: .*mirrord-session=daniel.*$"
        }
      },
      "dns": {
        "enabled": true,
        "filter": {
          "local": []
        }
      }
    }
  }
}
